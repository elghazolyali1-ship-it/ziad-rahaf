# رابط الاتصال بقاعدة بيانات MongoDB (من MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# اسم قاعدة البيانات (اختياري، افتراضي "wedding")
MONGODB_DB=wedding

# باسورد الدخول للوحة تحكم الأدمن (/admin)
ADMIN_PASSWORD=change-me

# مفتاح سري طويل وعشوائي لتوقيع جلسة تسجيل دخول الأدمن
SESSION_SECRET=generate-a-long-random-string
